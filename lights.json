                      "poster": { "color": "#7A1FA2", "color2": "#100018", "effect": ["Breathe", "Solid"], "speed": 200, "level": 90, "tt_ms": 150 } },
        { "at": 0.5, "window": { "color": "#7A1FA2", "color2": "#100018", "effect": ["Breathe", "Solid"], "speed": 200, "level": 90, "tt_ms": 200 },
                      "poster": { "color": "#7CFF2E", "color2": "#0A1A00", "effect": ["Breathe", "Solid"], "speed": 200, "level": 90, "tt_ms": 200 } }
      ]
    },
    "radiant": {
      "description": "Gold-white",
