        { "at": 0.08, "both": { "color": "#FF7A1A", "effect": "Solid", "level": 100, "tt_ms": 150 } },
        { "at": 0.30, "both": { "color": "#FF3A00", "effect": "Solid", "level": 60, "tt_ms": 400 } },
        { "at": 0.60, "both": { "color": "#801000", "effect": "Solid", "level": 25, "tt_ms": 400 } }
