        { "at": 0.0, "both": { "color": "#FFF2C0", "effect": "Solid", "level": 100, "tt_ms": 100 } },
        { "at": 0.5, "both": { "color": "#FFD870", "effect": "Solid", "level": 75, "tt_ms": 400 } }
      ]
    },
    "psychic": {
