      "steps": [
        { "at": 0.00, "both": { "color": "#FFD23C", "effect": "Solid", "level": 100, "tt_ms": 0 } },
        { "at": 0.12, "both": { "color": "#FFF4C0", "effect": "Solid", "level": 100, "tt_ms": 100 } },
        { "at": 0.30, "both": { "color": "#FFD23C", "color2": "#402800", "effect": ["Sparkle", "Twinkle", "Solid"], "speed": 255, "intensity": 255, "level": 100, "tt_ms": 150 } }
